# Deploy (Foundry) — copy to apps/contracts-solidity/.env (gitignored)
PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC_URL=
# Etherscan V2 API key: https://etherscan.io/myapikey
ARBISCAN_API_KEY=
# Optional DeployFaktur: existing MockIDR, CRE forwarder, relayer address
MOCK_IDR=
CRE_FORWARDER=
RELAYER=

# Frontend — copy to apps/web/.env.local
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MOCK_IDR_ADDRESS=
NEXT_PUBLIC_FAKTUR_REGISTRY_ADDRESS=
NEXT_PUBLIC_FAKTUR_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_FAKTUR_NFT_ADDRESS=
NEXT_PUBLIC_FAKTUR_RECEIVER_ADDRESS=
NEXT_PUBLIC_FAKTUR_KEEPER_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_SITE_URL=

# Server only (never NEXT_PUBLIC)
VERIFIER_PRIVATE_KEY=
