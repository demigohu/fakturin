# Copy to .env in this folder: cp .env.example .env  (gitignored; do not commit it).
# Addresses come from the DeployFaktur log (apps/contracts-solidity).

NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_MOCK_IDRX_ADDRESS=
NEXT_PUBLIC_FAKTUR_NFT_ADDRESS=
NEXT_PUBLIC_FAKTUR_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_FAKTUR_REGISTRY_ADDRESS=
NEXT_PUBLIC_FAKTUR_RECEIVER_ADDRESS=
NEXT_PUBLIC_FAKTUR_KEEPER_ADDRESS=
NEXT_PUBLIC_FAKTUR_RENDERER_ADDRESS=
# Chainlink ACE Cross-Chain Identity (self-deployed by DeployFaktur)
NEXT_PUBLIC_ACE_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ACE_CREDENTIAL_REGISTRY_ADDRESS=
# L2 block of the first deploy tx (not the "DeployBlock" log line: on Arbitrum that is the L1 block)
NEXT_PUBLIC_DEPLOY_BLOCK=
# Public URL of the web app (OG image links)
NEXT_PUBLIC_SITE_URL=

# Who runs the invoice check and closes overdue vaults: "cre" = Chainlink CRE workflows
# (apps/fakturin-cre, pm2 on a VPS); "relayer" = this app's server routes (instant, demo fallback).
NEXT_PUBLIC_VERIFIER=relayer

# Server only (never NEXT_PUBLIC). Demo relayer for /api/verify, /api/keeper and the simulated
# KYC/KYB issuer /api/identity. Needs VERIFIER_ROLE and must be the authorized ACE issuer
# (DeployFaktur sets both to RELAYER, default the deployer). Comment out to test the CRE path.
VERIFIER_PRIVATE_KEY=
