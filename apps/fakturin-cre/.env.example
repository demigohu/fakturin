# Copy to .env: cp .env.example .env (never commit it). Run `cre login` once on this machine,
# or set CRE_API_KEY instead.

# Wallet that sends the workflow reports through Chainlink's forwarder (needs Arbitrum Sepolia ETH).
CRE_ETH_PRIVATE_KEY=
# staging-settings = Arbitrum Sepolia; local-settings = anvil fork on 127.0.0.1:8545
CRE_TARGET=staging-settings

# Optional
# CRE_API_KEY=
# KEEPER_INTERVAL=60
