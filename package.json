{
  "name": "fakturin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-common": "1.8.24",
    "@reown/appkit-controllers": "1.8.24",
    "@reown/appkit-pay": "1.8.24",
    "@reown/appkit-polyfills": "1.8.24",
    "@reown/appkit-scaffold-ui": "1.8.24",
    "@reown/appkit-ui": "1.8.24",
    "@reown/appkit-utils": "1.8.24",
    "@reown/appkit-wallet": "1.8.24"
  }
}
